{
  "name": "vaelinya-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "verify:short-stories": "node scripts/verify-short-story-release.mjs",
    "verify:story-assets": "node scripts/verify-story-hero-assets.mjs",
    "build": "npm run verify:short-stories && npm run verify:story-assets && astro build",
    "preview": "astro preview",
    "test:builder": "node --test tests/vaelinya-builder/*.test.js",
    "test:search-discovery": "npm run build && node --test tests/search-discovery/*.test.mjs",
    "test": "npm run test:builder && npm run test:search-discovery",
    "validate:language-public": "node scripts/validate-language-public-boundary.mjs",
    "validate:ci-policy": "node scripts/validate-ci-cost-policy.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}

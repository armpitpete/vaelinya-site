---
import ShortProgrammeStoryLayout from '../../../layouts/ShortProgrammeStoryLayout.astro';
import { shortStories } from '../../../data/short-stories';
import { renderShortStoryMarkdown } from '../../../lib/renderShortStoryMarkdown';

export function getStaticPaths() {
  return shortStories.map((story, index) => ({
    params: { slug: story.slug },
    props: {
      story,
      previousStory: index > 0 ? { title: shortStories[index - 1].title, url: shortStories[index - 1].publicUrl } : undefined,
      nextStory: index + 1 < shortStories.length ? { title: shortStories[index + 1].title, url: shortStories[index + 1].publicUrl } : undefined,
    },
  }));
}

const { story, previousStory, nextStory } = Astro.props;
const bodyHtml = renderShortStoryMarkdown(story.bodyMarkdown);
---
<ShortProgrammeStoryLayout
  title={story.title}
  description={story.description}
  storyNumber={story.position}
  totalStories={57}
  heroImage={story.heroImage}
  heroImageAlt={story.heroImageAlt}
  previousStory={previousStory}
  nextStory={nextStory}
>
  <h1>{story.title}</h1>
  <Fragment set:html={bodyHtml} />
</ShortProgrammeStoryLayout>

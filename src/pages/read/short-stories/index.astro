---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { shortStories } from '../../../data/short-stories';
---
<BaseLayout title="57 Vaelinya short stories" description="The complete 57-story Vaelinya Short Story Programme in reader order.">
  <section class="page-section">
    <p class="eyebrow">Read</p>
    <h1>57 Vaelinya short stories</h1>
    <p class="lede">The complete short-story programme, in the accepted reader order.</p>
    <p>Read straight through or choose any story below. This first web edition preserves the accepted story text while the collection is proofread in public.</p>
    <ol class="story-grid story-list" aria-label="57 Vaelinya short stories">
      {shortStories.map((story) => (
        <li>
          <a class="story-card" href={story.publicUrl} aria-label={`Read ${story.title}`}>
            <span>Story {story.position}</span>
            <strong>{story.title}</strong>
            <span class="story-card-action" aria-hidden="true">Read story</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="link-list">
      <a href="/read/">All reading paths</a>
      <a href="/world/">Explore the world</a>
    </div>
  </section>
</BaseLayout>

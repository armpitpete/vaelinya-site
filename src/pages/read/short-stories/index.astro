---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const stories = (await getCollection('stories', ({ data }) => data.arc === 'Short Story Programme'))
  .sort((a, b) => a.data.story_number - b.data.story_number);
---
<BaseLayout title="57-story publication order" description="The accepted 57-story publication-order view, preserved alongside the Children of Vaelinya folders.">
  <section class="page-section">
    <p class="eyebrow">Alternate reading view</p>
    <h1>57-story publication order</h1>
    <p class="lede">This preserves the accepted interleaved order of the 57-story publication package.</p>
    <p>The main reader library is now organised as <strong>Children of Vaelinya</strong>: one eight-story folder for each child, followed by eight adventures together. This page remains available for readers who want the original interleaved programme order.</p>

    <div class="link-list">
      <a href="/read/children-of-vaelinya/">Open the Children of Vaelinya folders</a>
    </div>

    <ol class="story-grid story-list" aria-label="57-story publication order">
      {stories.map((story) => (
        <li>
          <a class="story-card" href={story.data.public_url} aria-label={`Read ${story.data.title}`}>
            <span>Publication position {story.data.story_number}</span>
            <strong>{story.data.title}</strong>
            <span class="story-card-action" aria-hidden="true">Read story</span>
          </a>
        </li>
      ))}
    </ol>

    <div class="link-list">
      <a href="/read/children-of-vaelinya/">Children of Vaelinya</a>
      <a href="/read/">All reading paths</a>
      <a href="/world/">Explore the world</a>
    </div>
  </section>
</BaseLayout>

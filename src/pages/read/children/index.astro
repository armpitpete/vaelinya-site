---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const children = [
  { name: 'Fina', story: 'Fina and the Smallest Bell', href: '/read/children/fina-and-the-smallest-bell/' },
  { name: 'Nira', story: 'Nira and the Lake That Listened', href: '/read/children/nira-and-the-lake-that-listened/' },
  { name: 'Liana', story: 'Liana and the Room That Held Its Breath', href: '/read/children/liana-and-the-room-that-held-its-breath/' },
  { name: 'Valen', story: 'Valen and the Broken Promise Stone', href: '/read/children/valen-and-the-broken-promise-stone/' },
  { name: 'Reo', story: 'Reo and the Song That Went the Wrong Way', href: '/read/children/reo-and-the-song-that-went-the-wrong-way/' },
  { name: 'Kaelen', story: 'Kaelen and the Door in the Wind', href: '/read/children/kaelen-and-the-door-in-the-wind/' },
  { name: 'Elara', story: 'Elara and the Star-Path Under the Hill', href: '/read/children/elara-and-the-star-path-under-the-hill/' },
];
---
<BaseLayout title="Children of Vaelinya starter stories" description="The seven non-Lina Story 1 entries, now part of the full Children of Vaelinya library.">
  <section class="page-section">
    <p class="eyebrow">Children of Vaelinya</p>
    <h1>The seven non-Lina Story 1s</h1>
    <p class="lede">These are not a separate seven-story series. Each is Story 1 of that child's eight-story folder.</p>
    <p>Lina already has her own eight-story path. Fina, Nira, Liana, Valen, Reo, Kaelen and Elara each begin here, then continue with Stories 2–8 in the full Children of Vaelinya library.</p>

    <ol class="story-grid story-list" aria-label="Seven non-Lina Story 1 entries">
      {children.map((child) => (
        <li>
          <a class="story-card" href={child.href} aria-label={`Read ${child.story}`}>
            <span>{child.name} · Story 1 of 8</span>
            <strong>{child.story}</strong>
            <span class="story-card-action" aria-hidden="true">Read Story 1</span>
          </a>
        </li>
      ))}
    </ol>

    <div class="link-list">
      <a href="/read/children-of-vaelinya/">Open all Children of Vaelinya folders</a>
      <a href="/read/children-of-vaelinya/lina/">Lina's eight stories</a>
      <a href="/read/children-of-vaelinya/together/">Eight adventures together</a>
    </div>
  </section>
</BaseLayout>
